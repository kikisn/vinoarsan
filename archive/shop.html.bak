<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Vino Arsan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fondamento:ital@0;1&family=Noto+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Decorative tropical elements -->
    <div class="tropical-decoration top-left">
        <img src="tropical-leaf-left.svg" alt="" class="tropical-leaf" />
        <img src="tropical-flowers-left.webp" alt="" class="tropical-flowers" />
    </div>
    <div class="tropical-decoration top-right">
        <img src="tropical-leaf-right.svg" alt="" class="tropical-leaf" />
        <img src="tropical-flowers-right.webp" alt="" class="tropical-flowers" />
    </div>

    <!-- Header -->
    <header>
        <div class="header-container">
            <div class="logo-section">
                <img src="vino-arsan-logo.svg" alt="Vino Arsan Logo" class="logo-image" />
            </div>
            <nav>
                <a href="index.html">HOME</a>
                <a href="shop.html">SHOP</a>
                <a href="#contact">CONTACT</a>
                <a href="#about">ABOUT</a>
                <a href="#pairings">PAIRINGS</a>
                <a href="limited-releases.html">LIMITED RELEASES</a>
            </nav>
            <div class="header-icons">
                <a href="#search" class="icon-link" aria-label="Search">
                    <img src="search.svg" alt="Search" class="icon-image" />
                </a>
                <a href="#cart" class="icon-link" aria-label="Shopping Cart">
                    <img src="cart.svg" alt="Cart" class="icon-image" />
                </a>
                <a href="#account" class="icon-link" aria-label="Account">
                    <img src="account.svg" alt="Account" class="icon-image" />
                </a>
            </div>
        </div>
    </header>

    <!-- Shop Hero Section -->
    <section class="shop-hero">
        <div class="shop-hero-container">
            <h1>Our Wines</h1>
            <p>Discover our collection of award-winning Filipino tropical wines, crafted from the finest local fruits.</p>
        </div>
    </section>

    <!-- Shop Main Section with Sidebar -->
    <section class="shop-section">
        <div class="shop-section-container">
            <!-- Sidebar Filters -->
            <aside class="shop-sidebar">
                <div class="filter-section">
                    <h3>Filters</h3>

                    <!-- Wine Type Filter -->
                    <div class="filter-group">
                        <h4>Wine Type</h4>
                        <label class="filter-option">
                            <input type="checkbox" name="wine-type" value="red" checked>
                            <span>Red Wines</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="wine-type" value="white" checked>
                            <span>White Wines</span>
                        </label>
                    </div>

                    <!-- Price Range Filter -->
                    <div class="filter-group">
                        <h4>Price Range</h4>
                        <label class="filter-option">
                            <input type="checkbox" name="price-range" value="0-300" checked>
                            <span>₱0 - ₱300</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="price-range" value="301-450" checked>
                            <span>₱301 - ₱450</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="price-range" value="451-600" checked>
                            <span>₱451 - ₱600</span>
                        </label>
                    </div>

                    <!-- Availability Filter -->
                    <div class="filter-group">
                        <h4>Availability</h4>
                        <label class="filter-option">
                            <input type="checkbox" name="availability" value="in-stock" checked>
                            <span>In Stock</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="availability" value="pre-order">
                            <span>Pre-Order</span>
                        </label>
                    </div>

                    <!-- Fruit Variety Filter -->
                    <div class="filter-group">
                        <h4>Fruit Variety</h4>
                        <label class="filter-option">
                            <input type="checkbox" name="fruit" value="lipote" checked>
                            <span>Lipote</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="fruit" value="bugnay" checked>
                            <span>Bugnay</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="fruit" value="calamansi" checked>
                            <span>Calamansi</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="fruit" value="mango" checked>
                            <span>Mango</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="fruit" value="dragonfruit" checked>
                            <span>Dragon Fruit</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="fruit" value="sangria" checked>
                            <span>Sangria</span>
                        </label>
                    </div>
                </div>

                <!-- Sort Section -->
                <div class="sort-section">
                    <h3>Sort By</h3>
                    <select class="sort-select" id="sort-products">
                        <option value="default">Featured</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="name-az">Name: A-Z</option>
                        <option value="name-za">Name: Z-A</option>
                        <option value="best-selling">Best Selling</option>
                    </select>
                </div>
            </aside>

            <!-- Products Content -->
            <div class="shop-content">
                <h2>Our Wines</h2>
                <div class="products-grid" id="products-container">
                <!-- Sangria -->
                <div class="product-card" data-type="red" data-fruit="sangria" data-price="275" data-name="Sangria" data-availability="in-stock">
                    <div class="product-image">
                        <img src="product-sangria.webp" alt="Sangria Wine" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Sangria</div>
                        <div class="volume-buttons">
                            <button class="volume-btn active" data-volume="200ml" data-price="275">200ml</button>
                            <button class="volume-btn" data-volume="750ml" data-price="400">750ml</button>
                        </div>
                        <div class="product-price">₱275</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Lipote, Bugnay Medium Sweet -->
                <div class="product-card" data-type="red" data-fruit="lipote bugnay" data-price="275" data-name="Lipote, Bugnay Medium Sweet" data-availability="in-stock">
                    <div class="product-image">
                        <img src="product-lipote-bugnay-sweet.webp" alt="Lipote, Bugnay Medium Sweet" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Lipote, Bugnay Medium Sweet</div>
                        <div class="volume-buttons">
                            <button class="volume-btn active" data-volume="200ml" data-price="275">200ml</button>
                            <button class="volume-btn" data-volume="750ml" data-price="500">750ml</button>
                        </div>
                        <div class="product-price">₱275</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Lipote, Bugnay Medium Dry -->
                <div class="product-card" data-type="red" data-fruit="lipote bugnay" data-price="500" data-name="Lipote, Bugnay Medium Dry" data-availability="in-stock">
                    <div class="product-image">
                        <img src="product-lipote-bugnay-dry.webp" alt="Lipote, Bugnay Medium Dry" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Lipote, Bugnay Medium Dry</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱500</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Malibugold Medium Sweet -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-malibugold-sweet.webp" alt="Malibugold Medium Sweet" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Malibugold Medium Sweet</div>
                        <div class="volume-buttons">
                            <button class="volume-btn active" data-volume="200ml" data-price="275">200ml</button>
                            <button class="volume-btn" data-volume="750ml" data-price="500">750ml</button>
                        </div>
                        <div class="product-price">₱275</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Malibugold Medium Dry -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-malibugold-dry.webp" alt="Malibugold Medium Dry" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Malibugold Medium Dry</div>
                        <div class="volume-buttons">
                            <button class="volume-btn active" data-volume="200ml" data-price="275">200ml</button>
                            <button class="volume-btn" data-volume="750ml" data-price="500">750ml</button>
                        </div>
                        <div class="product-price">₱275</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Lipote Medium Sweet -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-lipote-sweet.webp" alt="Lipote Medium Sweet" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Lipote Medium Sweet</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱450</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Lipote Medium Dry -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-lipote-dry.webp" alt="Lipote Medium Dry" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Lipote Medium Dry</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱450</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Bignay Medium Sweet -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-bignay-sweet.webp" alt="Bignay Medium Sweet" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Bignay Medium Sweet</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱450</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Bignay Medium Dry -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-bignay-dry.webp" alt="Bignay Medium Dry" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Bignay Medium Dry</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱450</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Dragon Fruit -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-dragonfruit.webp" alt="Dragon Fruit Wine" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Dragon Fruit</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱400</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Bignay, Pitaya -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-bignay-pitaya.webp" alt="Bignay, Pitaya Wine" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Bignay, Pitaya</div>
                        <div class="product-size">750ml</div>
                        <div class="product-price">₱450</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <h2 class="section-title">White Wines</h2>
                <div class="products-grid">
                <!-- Calamansi -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-calamansi.webp" alt="Calamansi White Wine" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Calamansi</div>
                        <div class="volume-buttons">
                            <button class="volume-btn active" data-volume="200ml" data-price="275">200ml</button>
                            <button class="volume-btn" data-volume="750ml" data-price="450">750ml</button>
                        </div>
                        <div class="product-price">₱275</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Mango -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-mango.webp" alt="Mango White Wine" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Mango</div>
                        <div class="volume-buttons">
                            <button class="volume-btn active" data-volume="200ml" data-price="275">200ml</button>
                            <button class="volume-btn" data-volume="750ml" data-price="450">750ml</button>
                        </div>
                        <div class="product-price">₱275</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>

                <!-- Honey Lemon -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="product-honey-lemon.webp" alt="Honey Lemon Wine" loading="lazy">
                    </div>
                    <div class="product-info">
                        <div class="product-name">Honey Lemon</div>
                        <div class="product-size">375ml</div>
                        <div class="product-price">₱400</div>
                        <button class="product-cta">ADD TO CART</button>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </section>

    <!-- Create Something Unforgettable Section -->
    <section class="unforgettable">
        <div class="unforgettable-container">
            <h2>Create Something Unforgettable</h2>
            <p>Whether it's a wedding, a corporate milestone, or the ultimate gift, we'll work with you to create a bespoke case or design custom labels that turn every award-winning bottle into a lasting memory.</p>
            <p class="contact-subtitle">Contact us for bulk orders and custom label inquiries.</p>
            <div class="contact-info">
                <div class="contact-item">
                    <span class="contact-label">E-MAIL</span>
                    <a href="mailto:sales@vinoarsan.com">sales@vinoarsan.com</a>
                </div>
                <div class="contact-item">
                    <span class="contact-label">PHONE</span>
                    <a href="tel:+639178661022">+63 917 866 1022</a>
                    <a href="tel:+6288242863">(02) 8824 2863</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-container">
            <div class="footer-left">
                <img src="vino-arsan-logo.svg" alt="Vino Arsan" class="footer-logo" />
            </div>
            <div class="footer-center">
                <div class="footer-socials">
                    <a href="#" class="social-link google" aria-label="Google Business Profile">
                        <img src="google.svg" alt="Google" />
                    </a>
                    <a href="#" class="social-link facebook" aria-label="Facebook">
                        <img src="facebook.svg" alt="Facebook" />
                    </a>
                    <a href="#" class="social-link instagram" aria-label="Instagram">
                        <img src="instagram.svg" alt="Instagram" />
                    </a>
                </div>
            </div>
            <div class="footer-right">
                <a href="#privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="scripts.js"></script>
</body>
</html>
